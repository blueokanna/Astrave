FROM alpine:3.21 AS pick

ARG TARGETPLATFORM
COPY docker_context /tmp/artifacts
WORKDIR /tmp/output
RUN set -eux; \
    case "$TARGETPLATFORM" in \
      linux/amd64) ARCH=amd64 ;; \
      linux/arm64) ARCH=arm64 ;; \
      *) echo "Unsupported architecture: $TARGETPLATFORM"; exit 1 ;; \
    esac; \
    cp "/tmp/artifacts/astrave-linux-${ARCH}/astrave" .

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tini
COPY --from=pick --chmod=755 /tmp/output/astrave /usr/local/bin/astrave
COPY docker/conf/astrave.toml /etc/astrave/astrave.toml
ENTRYPOINT ["/sbin/tini", "--", "astrave"]
CMD ["-c", "/etc/astrave/astrave.toml"]
